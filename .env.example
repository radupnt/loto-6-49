# Portul aplicației (Romarg/cPanel îl setează automat)
PORT=3000

# Actualizare date extrageri la fiecare X ore
AUTO_REFRESH_HOURS=3

# Secret pentru cron extern (Romarg cPanel → Cron Jobs)
# Generează un string lung aleatoriu și folosește-l în URL:
# curl "https://subdomeniu.ro/api/cron?secret=VALOAREA_TA"
CRON_SECRET=schimba-aceasta-valoare

# Mediu
NODE_ENV=production
